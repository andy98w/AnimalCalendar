{
  "rules": {
    ".read": false,
    ".write": false,
    "$uid": {
      "events": {
        ".read": "auth != null && auth.uid == $uid",
        "$event": {
          ".write": "auth != null && auth.uid == $uid && newData.exists() && data.child('deleted').val() != true",
          ".validate": "newData.hasChildren(['title', 'start', 'end', 'version', 'deleted'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
          },
          "start": {
            ".validate": "newData.isNumber()"
          },
          "end": {
            ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('start').val()"
          },
          "version": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
          },
          "deleted": {
            ".validate": "newData.isBoolean()"
          },
          "color": {
            ".validate": "newData.hasChildren(['primary', 'secondary'])",
            "primary": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
            },
            "secondary": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          },
          "operationId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          }
        }
      }
    }
  }
}
